# Скопируйте в .env и заполните. Комментарии — только на отдельных строках.

# --- обязательные ---
# токен от @BotFather
TELEGRAM_BOT_TOKEN=
# тот же Secret, что указан в настройках вебхука на GitHub
GITHUB_SECRET=

# --- HTTP ---
PORT=:8080
# Оба файла или ни одного. Для локальной разработки: make certs
TLS_CERT_FILE=
TLS_KEY_FILE=
# Таймауты (значения по умолчанию)
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=15s
# HTTP_IDLE_TIMEOUT=60s
# SHUTDOWN_TIMEOUT=10s
# NOTIFY_TIMEOUT=8s

# --- PostgreSQL ---
# Если DB_HOST пустой, связки хранятся в памяти до перезапуска
DB_HOST=
DB_PORT=5432
DB_USERNAME=pigeon
DB_PASSWORD=pigeon
DB_NAME=pigeon
DB_SSLMODE=disable

# --- логи ---
# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text
TELEGRAM_DEBUG=false
